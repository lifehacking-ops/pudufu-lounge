# 이 파일을 .env 로 복사하고 값을 채운다. .env 는 커밋되지 않는다.

# Supabase → Project Settings → Database → Connection string
#
#   마이그레이션(스키마·시드)  5432 직접 연결을 쓴다
#   앱 실행(Vercel)            6543 트랜잭션 풀러를 쓴다
#
# 비워 두면 데모로 돈다 — 프로토타입과 같은 목업이 뜨고 쓰기는 저장되지 않는다.
# 비밀번호는 여기 따로 적는다. 주소 한가운데를 고치지 않아도 된다.
DB_PASSWORD=
DATABASE_URL=

# SSO 가 붙기 전에 이 사람으로 본다. 26 = 프드프 관리자, 7 = 박현종(수강생)
DEV_USER_ID=7

# local  = ext_* 캐시만 읽는다 (프드프 없이 개발)
# remote = 프드프 API 를 호출한다
PUDUFU_MODE=local
PUDUFU_BASE=https://pudufu.net
PUDUFU_KEY=
